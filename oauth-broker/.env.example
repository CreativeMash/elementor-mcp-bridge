BROKER_PUBLIC_URL=https://figma-auth.example.com
FIGMA_OAUTH_CLIENT_ID=replace-with-figma-client-id
FIGMA_OAUTH_CLIENT_SECRET=replace-with-figma-client-secret
BROKER_RECORD_KEY=replace-with-a-random-32-character-minimum-secret
BROKER_STATE_DIR=/var/lib/elementor-figma-broker/state
WORDPRESS_CALLBACK_ALLOWLIST=https://example.com/wp-admin/admin-post.php?action=elementor_mcp_oauth_callback
FIGMA_OAUTH_SCOPES=file_content:read
